Options -Indexes
DirectoryIndex index.php index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Consolidate every public URL on the HTTPS + www canonical host.
    RewriteCond %{HTTP_HOST} ^(gsqilin\.cn|www\.gsqilin\.cn)$ [NC]
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} !^www\.gsqilin\.cn$ [NC]
    RewriteRule ^ https://www.gsqilin.cn%{REQUEST_URI} [R=301,L]

    # Replace legacy client-side redirects with crawlable permanent redirects.
    RewriteRule ^index\.html$ /index.php [R=301,L]
    RewriteRule ^products\.html$ /products.php [R=301,L]
    RewriteRule ^contact\.html$ /contact.php [R=301,L]
    RewriteRule ^information\.html$ /information.php [R=301,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    <FilesMatch "\.(?:avif|gif|jpe?g|png|svg|webp|woff2?)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.(?:css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/json application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
